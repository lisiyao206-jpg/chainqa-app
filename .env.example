# 环境变量模板：复制本文件为 .env，再填入你自己的值。.env 已写进 .gitignore，绝不会被上传
# （比赛要求：API 密钥等敏感信息不得出现在公开仓库中，须通过环境变量配置）

# 【必填】智谱 AI 的 API Key，在 https://bigmodel.cn 控制台获取
ZHIPU_API_KEY=your_api_key_here

# 【必填】管理员账号：用这个账号注册 / 登录后自动成为管理员，可以进入「管理后台」
ADMIN_ACCOUNT=your_admin_account

# 【可选】后端端口，默认 3000
# PORT=3000

# 【可选】智谱接口地址，一般不用改
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
